# The probes in a container, so the host needs only Docker, openssl and curl.
#   docker build -f Dockerfile.probes -t kclab-probes .
#   docker run --rm --network host -v "$HOME/oauthc:/data" -e KCLAB_HOME=/data kclab-probes probes.py S1
FROM python:3.12-slim
WORKDIR /lab
COPY pyproject.toml README.md ./
COPY kclab ./kclab
RUN pip install --no-cache-dir -q -e ".[dev]"
COPY . .
ENTRYPOINT ["python"]
