{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazuru-chidumbwe/keycloak-client-profiles-lab/results.schema.json",
  "title": "keycloak-client-profiles-lab results",
  "type": "object",
  "required": ["schema", "run_id", "state", "meta", "tests", "requirements", "notes"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "kclab-results/1"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Z0-9]+-[0-9a-f]{8}$"},
    "state": {"enum": ["S0", "S1", "S2L"]},
    "meta": {
      "type": "object",
      "required": ["keycloak_image", "lab_version", "started_utc"],
      "properties": {
        "keycloak_image": {"type": "string"},
        "keycloak_version": {"type": ["string", "null"]},
        "lab_version": {"type": "string"},
        "lab_commit": {"type": ["string", "null"]},
        "started_utc": {"type": "string"},
        "redacted": {"type": "boolean"}
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_id", "requirement", "client", "state", "verdict", "expected", "actual", "evidence"],
        "additionalProperties": false,
        "properties": {
          "test_id": {"type": "string", "pattern": "^P[0-9]+\\.[a-z0-9_.]+$"},
          "requirement": {"type": "string"},
          "client": {"type": "string"},
          "state": {"enum": ["S0", "S1", "S2L"]},
          "verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_APPLICABLE"]},
          "expected": {"type": "object"},
          "actual": {"type": "object"},
          "evidence": {"type": "array", "items": {"type": "string", "pattern": "^http-[0-9]{4,}$"}},
          "note": {"type": "string"}
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "client", "verdict"],
        "properties": {
          "requirement": {"type": "string"},
          "client": {"type": "string"},
          "verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_APPLICABLE"]}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
